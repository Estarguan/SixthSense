# Copy to backend/.env and fill in. Never commit the real .env file.

# Google Gemini (suspicious mode analysis)
GEMINI_API_KEY=your_gemini_key_here

# ElevenLabs (spoken guidance)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Optional: path to an unpacked Vosk model folder.
# Defaults to backend/normal_mode/model
# VOSK_MODEL_PATH=/absolute/path/to/vosk-model-small-en-us-0.15
